@startuml
title Audino Healthcare System - Object Diagram

object "mainController : MainController" as mc {
  selectedPatient = patient1
  currentPrescription = prescription1
  dataService = dataService1
  interactionEngine = interactionEngine1
}

object "patient1 : Patient" as p1 {
  patientId = "PAT-12345678"
  firstName = "John"
  lastName = "Doe"
  dateOfBirth = 1990-05-15
  gender = "Male"
  allergies = ["Penicillin", "Sulfa"]
  chronicConditions = ["Hypertension", "Diabetes"]
}

object "prescription1 : Prescription" as rx1 {
  prescriptionId = "RX-87654321"
  patient = patient1
  prescriber = "Dr. Admin"
  dateCreated = 2025-11-13T10:30:00
  status = DRAFT
}

object "prescribedDrug1 : PrescribedDrug" as pd1 {
  medicationId = "MED-001"
  dosage = "10mg"
  frequency = "Twice daily"
  duration = "7 days"
  instructions = "Take with food"
  prescriber = "Dr. Admin"
}

object "prescribedDrug2 : PrescribedDrug" as pd2 {
  medicationId = "MED-002"
  dosage = "500mg"
  frequency = "Once daily"
  duration = "30 days"
  instructions = "Take in morning"
  prescriber = "Dr. Admin"
}

object "medication1 : Medication" as m1 {
  medicationId = "MED-001"
  displayName = "Lisinopril"
  genericName = "Lisinopril"
  medicationType = TABLET
  pricePerUnit = 0.50
}

object "medication2 : Medication" as m2 {
  medicationId = "MED-002"
  displayName = "Metformin"
  genericName = "Metformin HCl"
  medicationType = TABLET
  pricePerUnit = 0.25
}

object "dataService1 : DataService" as ds {
  patients = [patient1, ...]
  medications = [medication1, medication2, ...]
  prescriptions = [prescription1, ...]
  users = [userAdmin, ...]
}

object "userAdmin : User" as u1 {
  username = "admin"
  role = "ADMIN"
}

object "interactionEngine1 : InteractionEngine" as ie {
  strategies = [allergyStrategy, drugDrugStrategy, conditionStrategy]
}

object "alert1 : InteractionAlert" as a1 {
  alertLevel = WARNING
  alertType = "Drug-Condition Interaction"
  message = "Lisinopril may affect blood pressure monitoring in hypertensive patients"
  acknowledged = false
}

mc --> p1 : selectedPatient
p1 --> rx1 : has
rx1 --> pd1 : contains
rx1 --> pd2 : contains
pd1 --> m1 : references
pd2 --> m2 : references
mc --> ds : uses
mc --> ie : uses
ds --> u1 : manages
rx1 --> a1 : produces

@enduml
