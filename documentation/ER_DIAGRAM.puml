@startuml
title Audino Relational Entity Relationship Diagram

hide circle
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F8F9FA
  BorderColor #2B2D42
}

entity "patients" as patients {
  * patient_id : TEXT <<PK>>
  --
  first_name : TEXT
  last_name : TEXT
  date_of_birth : TEXT
  gender : TEXT
  contact_number : TEXT
  allergies_json : TEXT
  chronic_conditions_json : TEXT
}

entity "medications" as medications {
  * medication_id : TEXT <<PK>>
  --
  generic_name : TEXT
  brand_name : TEXT
  rxnorm_code : TEXT
  medication_type : TEXT
  strength : TEXT
  concentration : TEXT
  route : TEXT
  active_ingredients_json : TEXT
  interaction_identifiers_json : TEXT
}

entity "prescriptions" as prescriptions {
  * prescription_id : TEXT <<PK>>
  --
  * patient_id : TEXT <<FK, UQ>>
  created_at : TEXT
  prescribed_by : TEXT
  status : TEXT
  alerts_json : TEXT
}

entity "prescribed_drugs" as prescribed_drugs {
  * id : INTEGER <<PK, AI>>
  --
  * prescription_id : TEXT <<FK>>
  * medication_id : TEXT <<FK>>
  dosage : TEXT
  frequency : TEXT
  duration : TEXT
  special_instructions : TEXT
  prescribed_by : TEXT
}

entity "interaction_rules" as interaction_rules {
  * id : INTEGER <<PK, CHECK id = 1>>
  --
  * rules_json : TEXT
}

patients ||--|| prescriptions : "active prescription header"
prescriptions ||--o{ prescribed_drugs : "contains line items"
medications ||--o{ prescribed_drugs : "referenced by line items"

interaction_rules .. medications : "rule payload references\ninteraction identifiers"
interaction_rules .. prescriptions : "alert generation context"

note right of prescriptions
Unique constraint on patient_id is used.
One active prescription header per patient is enforced.
end note

note bottom of prescribed_drugs
ON DELETE CASCADE is applied from prescriptions.
Medication FK is enforced for referential integrity.
end note

@enduml