<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="440.0" spacing="12.0" styleClass="dialog-container" stylesheets="@../css/application.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.audino.controller.PricingPromptController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label styleClass="dialog-title" text="Missing Pricing Information" />
      <Label fx:id="promptMessageLabel" styleClass="dialog-message" text="Please enter price per unit." wrapText="true" />
      <Label fx:id="errorLabel" textFill="red" visible="false" wrapText="true" />
      <VBox spacing="5.0">
         <children>
            <Label styleClass="form-label" text="Price Per Unit ($)" />
            <TextField fx:id="priceField" promptText="e.g., 2.50" styleClass="form-field" />
         </children>
      </VBox>
      <VBox spacing="5.0">
         <children>
            <Label styleClass="form-label" text="Admin Password (required)" />
            <PasswordField fx:id="adminPasswordField" promptText="Enter admin password" styleClass="form-field" />
         </children>
      </VBox>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancel" styleClass="secondary-btn" text="Cancel" />
            <Button mnemonicParsing="false" onAction="#handleSave" styleClass="primary-btn" text="Save Price" />
         </children>
         <VBox.margin>
            <Insets top="8.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
