<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="350.0" prefWidth="400.0" spacing="20.0" styleClass="dialog-container" stylesheets="@../css/application.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.audino.controller.LoginController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <Label styleClass="app-title" text="Audino Login" />
      <Label fx:id="errorLabel" textFill="red" visible="false" />
      <VBox spacing="5.0">
         <children>
            <Label styleClass="form-label" text="Username" />
            <TextField fx:id="usernameField" promptText="admin or user" styleClass="form-field" />
         </children>
      </VBox>
      <VBox spacing="5.0">
         <children>
            <Label styleClass="form-label" text="Password" />
            <PasswordField fx:id="passwordField" promptText="Password" styleClass="form-field" />
         </children>
      </VBox>
      <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" styleClass="primary-btn" text="Log In" />
   </children>
</VBox>
